# Salin ke backend/.env lalu sesuaikan bila port host berbeda.
APP_ENV=development
API_V1_STR=/api/v1

POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=volatisafe
POSTGRES_PASSWORD=volatisafe_secret
POSTGRES_DB=volatisafe_db
DATABASE_URL=postgresql+psycopg://volatisafe:volatisafe_secret@localhost:5433/volatisafe_db

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=/volatisafe/v1/node/+/telemetry

# true = formula analitik bawaan, tanpa LightGBM/SHAP.
MOCK_AI_PREDICTOR=true
