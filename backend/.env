# VolatiSafe AIoT Local Standalone Environment Configuration
API_V1_STR=/api/v1
PROJECT_NAME="VolatiSafe AIoT Backend"
VERSION="v1.0"

# Database Configuration (Default: SQLite local standalone)
USE_SQLITE=True
DATABASE_URL=sqlite:///./volatisafe.db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=volatisafe
POSTGRES_PASSWORD=volatisafe_secret
POSTGRES_DB=volatisafe_db

# MQTT Broker (Set to True if local Mosquitto service is running on 1883)
MQTT_ENABLED=False
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=/volatisafe/v1/node/+/telemetry

# AI & Simulation Engine
MOCK_AI_PREDICTOR=True
