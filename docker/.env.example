# ==============================================================================
# VOLATISAFE AIOT — DOCKER ENVIRONMENT CONFIGURATION EXAMPLE
# Copy file ini menjadi .env lalu ubah nilai port jika diperlukan.
# ==============================================================================

# --- Port Services (Host Machine) ---
# Jika port 3000 terpakai, ganti FRONTEND_PORT=3001
FRONTEND_PORT=3000

# Jika port 8000 terpakai (misal oleh CivicTrack/service lain), ganti BACKEND_PORT=8001
BACKEND_PORT=8000

# Jika port 5432 terpakai (misal oleh PostgreSQL lokal), ganti DB_PORT=5433
DB_PORT=5433

# Port MQTT Broker Mosquitto
MQTT_PORT=1883

# Port Web Database Manager (Adminer)
DB_ADMIN_PORT=8082

# --- Database Credentials ---
POSTGRES_USER=volatisafe
POSTGRES_PASSWORD=volatisafe_secret
POSTGRES_DB=volatisafe_db
