{
  "version": 1,
  "author": "VolatiSafe AIoT Team",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_moisture",
      "top": -120,
      "left": 160,
      "attrs": { "label": "Kelembaban Tanah (% VWC - GPIO34)" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_ph",
      "top": 140,
      "left": 160,
      "attrs": { "label": "Sensor pH Tanah (GPIO32)" }
    },
    {
      "type": "wokwi-ds18b20",
      "id": "sensor_temp",
      "top": -90,
      "left": -180,
      "attrs": { "label": "DS18B20 Suhu Probe (GPIO4)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_pullup",
      "top": -30,
      "left": -120,
      "attrs": { "value": "4700" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "pot_moisture:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pot_moisture:GND", "black", [ "v0" ] ],
    [ "pot_moisture:SIG", "esp:34", "blue", [ "v0" ] ],

    [ "esp:3V3", "pot_ph:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pot_ph:GND", "black", [ "v0" ] ],
    [ "pot_ph:SIG", "esp:32", "green", [ "v0" ] ],

    [ "esp:3V3", "sensor_temp:VDD", "red", [ "v0" ] ],
    [ "esp:GND.2", "sensor_temp:GND", "black", [ "v0" ] ],
    [ "esp:4", "sensor_temp:DQ", "orange", [ "v0" ] ],

    [ "esp:3V3", "r_pullup:1", "red", [ "v0" ] ],
    [ "sensor_temp:DQ", "r_pullup:2", "orange", [ "v0" ] ]
  ],
  "dependencies": {}
}
